{
  "name": "akasha",
  "version": "0.1.0",
  "private": true,
  "description": "A family document hub for parents, powered by Paperless-ngx + AI",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "concurrently -n mock,server,web \"node mock/paperless-mock.ts\" \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "mock": "node mock/paperless-mock.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
