# ---- Paperless-ngx (only used by docker-compose.example.yml) ----
# required: random strings, e.g. from `openssl rand -hex 32`
PAPERLESS_SECRET_KEY=
PAPERLESS_DBPASS=
# required: the first admin account (also your first Akasha login)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
# The address you open Paperless at, e.g. https://docs.example.com
PAPERLESS_PUBLIC_URL=http://localhost:8000
TZ=Asia/Shanghai

# ---- Akasha ----
# Where Akasha reaches Paperless-ngx. The example compose sets this for you;
# if Paperless runs elsewhere, use its LAN address, e.g. http://192.168.1.10:8000
PAPERLESS_URL=http://paperless:8000

# required: random string, at least 32 characters. Signs the login cookie and
# encrypts pending sign-up passwords and the AI key. Keep it stable.
# Generate one with: openssl rand -hex 32
AKASHA_SECRET=

# Family members are Paperless tags with this prefix, e.g. "家人/妈妈".
AKASHA_PEOPLE_PREFIX=家人/

# Name of the Paperless date custom field used for expiry/renewal reminders.
AKASHA_EXPIRY_FIELD=到期日

# Created by "first-time setup" in Settings (comma separated). Admins can rename,
# add and remove them later in Settings.
AKASHA_DEFAULT_CATEGORIES=保险,证件,医疗,房产,车辆,票据,其他
AKASHA_DEFAULT_PEOPLE=爸爸,妈妈

# In-app feedback → GitHub issues (optional). Use a fine-grained token with
# "Issues: Read and write" on this one repository only. If unset, feedback is
# saved to $AKASHA_DATA_DIR/feedback.jsonl instead.
AKASHA_GITHUB_TOKEN=
# Feedback is anonymous: no username, and ID/phone/card numbers, emails and
# family names are masked. Point this at your own (ideally private) repo.
AKASHA_FEEDBACK_REPO=
AKASHA_DATA_DIR=/data

# Paperless group that approved family members join. Everything saved through
# Akasha is shared with it.
AKASHA_FAMILY_GROUP=家人

# Optional: let a vision model read photos and pre-fill the form. All four
# values can instead be set by an admin in Settings (address, API type, key,
# model; the key is stored encrypted in the data volume). Settings win. Any
# OpenAI-compatible API works (e.g. https://dashscope.aliyuncs.com/compatible-mode/v1
# with qwen-vl-max). Photos are sent to this provider, so pick one you trust.
AKASHA_AI_BASE_URL=
AKASHA_AI_API_KEY=
AKASHA_AI_MODEL=
# "chat" for /chat/completions (most providers) or "responses" for the
# Responses API (OpenAI, Codex-style relays).
AKASHA_AI_WIRE_API=chat
