# Where Akasha reaches Paperless-ngx (inside the Docker network).
PAPERLESS_URL=http://paperless:8000

# Random string, at least 32 characters. Signs the login cookie.
# Generate one with: openssl rand -hex 32
AKASHA_SECRET=

# Family members are Paperless tags with this prefix, e.g. "家人/妈妈".
AKASHA_PEOPLE_PREFIX=家人/

# Name of the Paperless date custom field used for expiry/renewal reminders.
AKASHA_EXPIRY_FIELD=到期日

# Created by "first-time setup" in Settings (comma separated).
AKASHA_DEFAULT_CATEGORIES=保险,证件,医疗,房产,车辆,票据,其他
AKASHA_DEFAULT_PEOPLE=爸爸,妈妈
