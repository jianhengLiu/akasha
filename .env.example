# Where Akasha reaches Paperless-ngx (inside the Docker network).
PAPERLESS_URL=http://paperless:8000

# Random string, at least 32 characters. Signs the login cookie.
# Generate one with: openssl rand -hex 32
AKASHA_SECRET=

# Family members are Paperless tags with this prefix, e.g. "家人/妈妈".
AKASHA_PEOPLE_PREFIX=家人/

# Name of the Paperless date custom field used for expiry/renewal reminders.
AKASHA_EXPIRY_FIELD=到期日

# Created by "first-time setup" in Settings (comma separated).
AKASHA_DEFAULT_CATEGORIES=保险,证件,医疗,房产,车辆,票据,其他
AKASHA_DEFAULT_PEOPLE=爸爸,妈妈

# In-app feedback → GitHub issues (optional). Use a fine-grained token with
# "Issues: Read and write" on this one repository only. If unset, feedback is
# saved to $AKASHA_DATA_DIR/feedback.jsonl instead.
AKASHA_GITHUB_TOKEN=
AKASHA_FEEDBACK_REPO=jianhengLiu/akasha
AKASHA_DATA_DIR=/data

# Paperless group that approved family members join. Everything saved through
# Akasha is shared with it.
AKASHA_FAMILY_GROUP=家人

# Optional: let a vision model read photos and pre-fill the form. Any
# OpenAI-compatible API works (e.g. https://dashscope.aliyuncs.com/compatible-mode/v1
# with qwen-vl-max). Photos are sent to this provider, so pick one you trust.
AKASHA_AI_BASE_URL=
AKASHA_AI_API_KEY=
AKASHA_AI_MODEL=
